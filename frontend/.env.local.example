# GitHub OAuth App credentials (github.com/settings/developers)
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# NextAuth
NEXTAUTH_SECRET=generate_a_random_string
NEXTAUTH_URL=http://localhost:3000

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Signaling server URL
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# Comma-separated GitHub usernames allowed into /admin (client-side gate;
# the backend independently enforces this via ADMIN_GITHUB_USERNAMES)
NEXT_PUBLIC_ADMIN_USERNAMES=your_github_username

# Server-side only (never NEXT_PUBLIC_) — must match backend's
# INTERNAL_API_SECRET, sent on the server-to-server /users/sync call.
INTERNAL_API_SECRET=generate_another_random_string
