DATABASE_URL=postgresql://devconnect:devconnect123@localhost:5432/devconnect
REDIS_URL=redis://localhost:6379

# Must match frontend's NEXTAUTH_SECRET so the backend can verify session tokens
JWT_SECRET=generate_a_random_string

GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Shared secret that only the Next.js server (not a browser) sends when
# calling POST /users/sync — see routes/users.py.
INTERNAL_API_SECRET=generate_another_random_string

# Comma-separated GitHub usernames allowed to view /admin and GET /reports.
ADMIN_GITHUB_USERNAMES=your-github-username
